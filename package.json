{
  "name": "yusa",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test src/engine/*.test.ts",
    "scan": "node src/cli.ts",
    "build:skill": "rolldown src/pack-cli.ts --platform node --format esm --file skills/yusa-skill-audit/yusa.mjs",
    "build:mcp": "rolldown src/mcp.ts --platform node --format esm --file mcp/yusa-mcp.mjs",
    "build:action": "rolldown src/action.ts --platform node --format esm --file action/yusa-action.mjs",
    "bench": "bash bench/fetch.sh && node bench/run.ts bench/data/train.jsonl && node bench/run.ts bench/data/test.jsonl"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "clsx": "^2.1.1",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
